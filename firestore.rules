rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is an admin
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to get user's school ID
    function getUserSchool() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId;
    }
    
    // Helper function to check if user belongs to the same school as the resource
    function belongsToSameSchool() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        resource.data.schoolId == getUserSchool();
    }
    
    // Helper function to check if new resource matches user's school
    function newResourceMatchesUserSchool() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        request.resource.data.schoolId == getUserSchool();
    }
    
    // User profiles - users can only read/write their own profile
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAuthenticated() && request.auth.uid == userId && 
        // Prevent users from modifying their own role
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow create: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // User roles - separate collection for security
    // Only admins can read/write roles, users cannot modify their own roles
    match /user_roles/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin() && request.auth.uid != userId; // Admins can't change their own role
      allow create: if isAdmin();
      allow delete: if isAdmin() && request.auth.uid != userId;
    }
    
    // Students collection - requires authentication AND school membership
    match /students/{studentId} {
      // Read only students from user's school (or admin can read all)
      allow read: if isAuthenticated() && (belongsToSameSchool() || isAdmin());
      allow create: if isAuthenticated() && 
        newResourceMatchesUserSchool() &&
        request.resource.data.keys().hasAll(['studentNumber', 'firstName', 'lastName', 'grade']) &&
        request.resource.data.studentNumber is string &&
        request.resource.data.studentNumber.size() <= 20 &&
        request.resource.data.firstName.size() <= 50 &&
        request.resource.data.lastName.size() <= 50;
      allow update: if isAuthenticated() && belongsToSameSchool();
      allow delete: if isAdmin();
    }
    
    // Benchmarks collection - requires authentication AND school membership
    match /benchmarks/{benchmarkId} {
      allow read: if isAuthenticated() && (belongsToSameSchool() || isAdmin());
      allow create: if isAuthenticated() && 
        newResourceMatchesUserSchool() &&
        request.resource.data.keys().hasAll(['studentId', 'assessmentType', 'score']) &&
        request.resource.data.studentId is string &&
        request.resource.data.assessmentType is string;
      allow update: if isAuthenticated() && belongsToSameSchool();
      allow delete: if isAdmin();
    }
    
    // Markbook collection - requires authentication AND school membership
    match /markbook/{entryId} {
      allow read: if isAuthenticated() && (belongsToSameSchool() || isAdmin());
      allow create: if isAuthenticated() && 
        newResourceMatchesUserSchool() &&
        request.resource.data.keys().hasAll(['studentId', 'subject', 'taskName', 'score']) &&
        request.resource.data.studentId is string &&
        request.resource.data.subject is string;
      allow update: if isAuthenticated() && belongsToSameSchool();
      allow delete: if isAdmin();
    }
    
    // Homerooms collection - primary class identifier
    // For development: allow authenticated users to manage homerooms
    // For production: restrict to admins only by uncommenting the admin checks
    match /homerooms/{homeroomId} {
      // Read: any authenticated user in the same school
      allow read: if isAuthenticated();
      // Create: any authenticated user (for dev) - change to isAdmin() for production
      allow create: if isAuthenticated();
      // Update: any authenticated user (for dev) - change to isAdmin() for production  
      allow update: if isAuthenticated();
      // Delete: any authenticated user (for dev) - change to isAdmin() for production
      allow delete: if isAuthenticated();
    }
    
    // Legacy classes collection - requires authentication AND school membership
    match /classes/{classId} {
      allow read: if isAuthenticated() && (belongsToSameSchool() || isAdmin());
      allow create: if isAuthenticated() && newResourceMatchesUserSchool();
      allow update: if isAuthenticated() && belongsToSameSchool();
      allow delete: if isAdmin();
    }
    
    // Schools collection - for multi-tenant support
    match /schools/{schoolId} {
      // Users can only read their own school
      allow read: if isAuthenticated() && getUserSchool() == schoolId;
      allow write: if isAdmin();
      
      // School members subcollection
      match /members/{memberId} {
        allow read: if isAuthenticated() && getUserSchool() == schoolId;
        allow write: if isAdmin();
      }
    }
    
    // Support plans - sensitive data, requires authentication AND school membership
    match /support_plans/{planId} {
      allow read: if isAuthenticated() && (belongsToSameSchool() || isAdmin());
      allow create: if isAuthenticated() && newResourceMatchesUserSchool();
      allow update: if isAuthenticated() && belongsToSameSchool();
      allow delete: if isAdmin();
    }
    
    // Staff/Teachers collection - docId = Firebase UID
    // For development: allow authenticated users to manage staff
    // For production: restrict create/update/delete to admins only
    match /teachers/{teacherId} {
      // Read: any authenticated user in the same school
      allow read: if isAuthenticated();
      // Create: admins only (or authenticated for dev)
      allow create: if isAuthenticated();
      // Update: admins only (or authenticated for dev)
      allow update: if isAuthenticated();
      // Delete: admins only
      allow delete: if isAdmin();
    }
  }
}
