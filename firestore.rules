rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is an admin
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if user belongs to the same school
    function belongsToSchool(schoolId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == schoolId;
    }
    
    // User profiles - users can only read/write their own profile
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAuthenticated() && request.auth.uid == userId && 
        // Prevent users from modifying their own role
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow create: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // User roles - separate collection for security
    // Only admins can read/write roles, users cannot modify their own roles
    match /user_roles/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin() && request.auth.uid != userId; // Admins can't change their own role
      allow create: if isAdmin();
      allow delete: if isAdmin() && request.auth.uid != userId;
    }
    
    // Students collection - requires authentication and school membership
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
        request.resource.data.keys().hasAll(['studentNumber', 'firstName', 'lastName', 'grade']) &&
        request.resource.data.studentNumber is string &&
        request.resource.data.studentNumber.size() <= 20 &&
        request.resource.data.firstName.size() <= 50 &&
        request.resource.data.lastName.size() <= 50;
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // Benchmarks collection - requires authentication
    match /benchmarks/{benchmarkId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
        request.resource.data.keys().hasAll(['studentId', 'assessmentType', 'score']) &&
        request.resource.data.studentId is string &&
        request.resource.data.assessmentType is string;
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // Markbook collection - requires authentication
    match /markbook/{entryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
        request.resource.data.keys().hasAll(['studentId', 'subject', 'taskName', 'score']) &&
        request.resource.data.studentId is string &&
        request.resource.data.subject is string;
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // Classes collection - requires authentication
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // Schools collection - for multi-tenant support
    match /schools/{schoolId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
      
      // School members subcollection
      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }
    
    // Support plans - sensitive data, requires authentication
    match /support_plans/{planId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }
  }
}
